---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { contact, documents, infrastructure, incentives, official } from '../data/site';
import { getMeetings, formatDate, meetingTitle, docOf } from '../lib/meetings';

const { upcoming, past } = await getMeetings();
const next = upcoming[0];
const nextAgenda = next && docOf(next, 'Agenda');
// Meetings with a posted agenda (some special meetings only list minutes).
const recent = past.filter((m) => docOf(m, 'Agenda')).slice(0, 3);
const latestAgenda = past.find((m) => docOf(m, 'Agenda'));
const latestMinutes = past.find((m) => docOf(m, 'Minutes'));

const parks = (await getCollection('parks')).map((p) => p.data).sort((a, b) => a.order - b.order);
const news = (await getCollection('news'))
  .map((n) => n.data)
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);

const short = (iso: string) => formatDate(iso, 'short').replace(/, \d{4}$/, '');
---

<Base
  preloadImage="hero"
  title="Port of Centralia | Industrial sites on the I-5 corridor"
  description="Three industrial parks between Seattle and Portland with rail, utilities, and sites from 1 to 100 acres. Commission meetings, agendas, and minutes in one place."
>
  <!-- Hero: text sits on solid navy, the photo is cropped diagonally beside it -->
  <section class="hero on-dark" aria-labelledby="hero-heading">
    <div class="container hero__inner">
      <h1 id="hero-heading">Room to grow on the I-5 corridor</h1>
      <p class="hero__lede">
        Three industrial parks between Seattle and Portland with rail, utilities, and sites from 1 to 100 acres.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="/#parks">Find a site <Icon name="arrow" /></a>
        <a class="btn btn--ghost-light" href="/meetings">Upcoming meetings <Icon name="arrow" /></a>
      </div>
    </div>
    <div class="hero__media">
      <Photo image="hero" sizes="(min-width: 1000px) 50vw, 100vw" priority />
    </div>
    <svg class="hero__curve" viewBox="0 0 1440 64" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path d="M0 64V40C360 6 760 0 1440 30v34z" fill="#f4f7fa" />
      <path d="M0 40C360 6 760 0 1440 30" fill="none" stroke="#2a6139" stroke-width="5" vector-effect="non-scaling-stroke" />
    </svg>
  </section>

  <!-- Top tasks -->
  <section class="tasks" aria-labelledby="tasks-heading">
    <div class="container">
      <div class="tasks__inner">
        <h2 id="tasks-heading">Top public tasks in one click</h2>
        <ul class="tasks__list">
          <li>
            <div class="task">
              <span class="task__badge"><Icon name="calendar" /></span>
              <h3><a href="/meetings#upcoming">Next Commission Meeting</a></h3>
              {
                next ? (
                  <p class="task__detail">
                    {formatDate(next.date, 'short')}
                    {next.time && <>, {next.time}</>}
                    <br />
                    {nextAgenda ? 'Agenda posted' : 'Agenda not yet posted'}
                  </p>
                ) : (
                  <p class="task__detail">Date to be announced</p>
                )
              }
            </div>
          </li>
          <li>
            <div class="task">
              <span class="task__badge"><Icon name="document" /></span>
              <h3><a href="/meetings">Latest Agenda &amp; Minutes</a></h3>
              <p class="task__detail">
                {latestAgenda && <>Agenda: {short(latestAgenda.date)}</>}
                <br />
                {latestMinutes && <>Minutes: {short(latestMinutes.date)}</>}
              </p>
            </div>
          </li>
          <li>
            <div class="task">
              <span class="task__badge"><Icon name="play" /></span>
              <h3><a href={documents.meetingVideos}>Watch Meeting Videos</a></h3>
              <p class="task__detail">Recordings on the Port's YouTube channel</p>
            </div>
          </li>
          <li>
            <div class="task">
              <span class="task__badge"><Icon name="megaphone" /></span>
              <h3><a href={official.notices}>Public Notices</a></h3>
              <p class="task__detail">Notices, newsletters, and documents</p>
            </div>
          </li>
          <li>
            <div class="task">
              <span class="task__badge"><Icon name="hardhat" /></span>
              <h3><a href="#rosters">Join a Contractor Roster</a></h3>
              <p class="task__detail">Small Works and A&amp;E rosters</p>
            </div>
          </li>
          <li>
            <div class="task">
              <span class="task__badge"><Icon name="mail" /></span>
              <h3><a href="#contact">Contact the Port</a></h3>
              <p class="task__detail">{contact.phone}<br />Mon to Fri, 8 to 5</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Parks -->
  <section class="section" id="parks" aria-labelledby="parks-heading">
    <div class="container">
      <div class="parks__grid">
        <div class="parks__intro">
          <p class="eyebrow">Industrial parks</p>
          <h2 id="parks-heading">Three parks, one Master Plan</h2>
          <p>
            The Port offers three industrial parks with multimodal access and sites from 1 to 100 acres.
          </p>
          <a class="btn btn--outline" href={official.industrialParks}>Explore our parks <Icon name="arrow" /></a>
        </div>
        <ul class="park-cards">
          {
            parks.map((park) => (
              <li class="park-card">
                <div class="park-card__media">
                  <Photo image={park.image as 'park1' | 'park2' | 'park3'} sizes="(min-width: 1000px) 300px, (min-width: 560px) 45vw, 92vw" />
                </div>
                <div class="park-card__body">
                  <h3>{park.name}</h3>
                  <ul class="checks">
                    {park.facts.map((fact) => (
                      <li>
                        <Icon name="check" />
                        {fact}
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="parks__note">
        Options include land lease, build-to-suit, and outright sale. The Master Plan was adopted in 1990 and revised in
        2023. <a href={documents.masterPlan}>Read the 2023 Master Plan (PDF)</a>
      </p>
    </div>
  </section>

  <!-- Infrastructure and incentives -->
  <section class="section section--tint" aria-label="Infrastructure and incentives">
    <div class="container feature-pair">
      <article class="panel panel--photo" id="infrastructure" aria-labelledby="infra-heading">
        <div class="panel__photo">
          <Photo image="rail" sizes="(min-width: 1000px) 220px, 100vw" />
        </div>
        <div class="panel__head panel__head--navy">
          <Icon name="train" />
          <h2 id="infra-heading">Infrastructure ready on day one</h2>
        </div>
        <div class="panel__body">
          <ul class="icon-list">
            {
              infrastructure.map((item) => (
                <li>
                  <Icon name={item.icon} />
                  {item.text}
                </li>
              ))
            }
          </ul>
        </div>
      </article>

      <article class="panel" id="incentives" aria-labelledby="incentives-heading">
        <div class="panel__head panel__head--green">
          <Icon name="coins" />
          <h2 id="incentives-heading">Incentives that lower your costs</h2>
        </div>
        <div class="panel__body">
          <ul class="checks checks--two">
            {
              incentives.map((item) => (
                <li>
                  <Icon name="check" />
                  {item}
                </li>
              ))
            }
          </ul>
          <div class="panel__cta">
            <a class="btn btn--primary" href={documents.bondOverview}>
              Read the bond overview (PDF) <Icon name="arrow" />
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- Meetings, news, community -->
  <section class="section" aria-label="Meetings and news">
    <div class="container trio">
      <article class="panel" aria-labelledby="meetings-heading">
        <div class="panel__head panel__head--navy">
          <Icon name="people" />
          <h2 id="meetings-heading">Open meetings, easy to follow</h2>
        </div>
        <div class="panel__body">
          <ul class="list-rows">
            {
              recent.map((m) => {
                const agenda = docOf(m, 'Agenda');
                const minutes = docOf(m, 'Minutes');
                const when = formatDate(m.date);
                return (
                  <li class="meeting-row">
                    <time datetime={m.date}>{formatDate(m.date, 'short')}</time>
                    <div>
                      <p class="meeting-row__title">{meetingTitle(m)}</p>
                      <ul class="doc-links">
                        {agenda ? (
                          <li><a href={agenda.href} aria-label={`Agenda, ${when} (PDF)`}>Agenda</a></li>
                        ) : (
                          <li class="pending">No agenda posted</li>
                        )}
                        {minutes ? (
                          <li><a href={minutes.href} aria-label={`Minutes, ${when} (PDF)`}>Minutes</a></li>
                        ) : (
                          <li class="pending">Minutes pending</li>
                        )}
                        {m.video && (
                          <li><a href={m.video} aria-label={`Video, ${when} (YouTube)`}>Video</a></li>
                        )}
                      </ul>
                    </div>
                  </li>
                );
              })
            }
          </ul>
          <div class="panel__foot">
            <a class="text-link" href="/meetings">View all meetings <Icon name="arrow" /></a>
          </div>
        </div>
      </article>

      <article class="panel" aria-labelledby="news-heading">
        <div class="panel__head panel__head--green">
          <Icon name="news" />
          <h2 id="news-heading">News &amp; notices</h2>
        </div>
        <div class="panel__body">
          <ul class="list-rows">
            {
              news.map((item) => (
                <li class="news-item">
                  <a href={item.href}>{item.title}</a>
                  <p>
                    <time datetime={item.date}>{formatDate(item.date, 'short')}</time> · {item.category}
                  </p>
                </li>
              ))
            }
          </ul>
          <div class="panel__foot">
            <a class="text-link" href={official.news}>View all news <Icon name="arrow" /></a>
          </div>
        </div>
      </article>

      <article class="community on-dark" aria-labelledby="community-heading">
        <div class="community__media">
          <Photo image="community" sizes="(min-width: 1100px) 380px, (min-width: 760px) 46vw, 92vw" />
        </div>
        <div class="community__body">
          <h2 id="community-heading">Building a stronger, more prosperous Centralia.</h2>
          <a class="btn btn--primary" href={official.history}>Learn more about the Port <Icon name="arrow" /></a>
        </div>
      </article>
    </div>
  </section>

  <!-- Rosters -->
  <section class="section section--rosters" id="rosters" aria-labelledby="rosters-heading">
    <div class="container">
      <div class="rosters on-dark">
        <div>
          <p class="eyebrow">For contractors</p>
          <h2 id="rosters-heading">Work with the Port</h2>
          <p>
            The Port keeps a Small Works Roster and an Architectural &amp; Engineering Roster for upcoming projects. The
            rosters are created every January and updated through December 31.
          </p>
        </div>
        <div class="rosters__actions">
          <a class="btn btn--primary" href={documents.smallWorksApplication}>
            2026 Small Works Roster application (PDF) <Icon name="arrow" />
          </a>
          <a class="btn btn--ghost-light" href={documents.aeForm330}>
            A&amp;E roster: Standard Form 330 (PDF) <Icon name="arrow" />
          </a>
          <p class="rosters__note">An accessible online application is planned for a later phase.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section" id="contact" aria-labelledby="contact-heading">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 id="contact-heading">Visit or call the Port</h2>
        <dl class="contact-list">
          <div>
            <dt><Icon name="pin" />Address</dt>
            <dd>
              {contact.street}, {contact.city}, {contact.region} {contact.postalCode}<br />
              <a href={contact.mapsHref}>Get directions in Google Maps</a>
            </dd>
          </div>
          <div>
            <dt><Icon name="clock" />Office hours</dt>
            <dd>{contact.hours}</dd>
          </div>
          <div>
            <dt><Icon name="phone" />Phone</dt>
            <dd><a href={contact.phoneHref}>{contact.phone}</a></dd>
          </div>
          <div>
            <dt><Icon name="fax" />Fax</dt>
            <dd>{contact.fax}</dd>
          </div>
          <div>
            <dt><Icon name="mail" />Email</dt>
            <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
          </div>
        </dl>
      </div>
      <div class="map">
        <iframe
          title={`Map showing the Port of Centralia office at ${contact.street}, ${contact.city}`}
          src="https://www.google.com/maps?q=3508+Galvin+Road,+Centralia,+WA+98531&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
</Base>
