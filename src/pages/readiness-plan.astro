---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

// Findings from portofcentralia.com, checked Oct 31, 2026: Lighthouse 12 (mobile)
// on the homepage and the agendas page, plus a structure check of the posted PDFs.
type Status = 'done' | 'phase1' | 'phase2';

const statusLabel: Record<Status, string> = {
  done: 'Done in demo',
  phase1: 'At launch',
  phase2: 'After launch',
};

// `ref` points to the RFP section or WCAG 2.1 success criterion behind each row.
const groups: { title: string; rows: { need: string; ref: string; today: string; fix: string; status: Status }[] }[] = [
  {
    title: 'Accessibility: ADA Title II (WCAG 2.1 AA)',
    rows: [
      {
        need: 'Readable text contrast',
        ref: 'WCAG 1.4.3',
        today: '71 contrast failures across the homepage and agendas page',
        fix: 'Every color pair tested to 4.5:1 or better, text never placed on photos',
        status: 'done',
      },
      {
        need: 'Every button and link has a name',
        ref: 'WCAG 4.1.2, 2.4.4',
        today: '89 unlabeled buttons and 11 unlabeled links',
        fix: 'Semantic HTML with visible, descriptive labels',
        status: 'done',
      },
      {
        need: 'Logical page structure',
        ref: 'WCAG 1.3.1, 2.4.6',
        today: 'Heading levels skip on the homepage',
        fix: 'One H1 per page, ordered headings, landmarks, skip link',
        status: 'done',
      },
      {
        need: 'Keyboard and screen reader access',
        ref: 'WCAG 2.1.1, 2.4.7',
        today: 'Relies on an add-on accessibility toolbar',
        fix: 'Built-in access: keyboard menus, focus rings, no overlay. Manual NVDA and VoiceOver pass before launch',
        status: 'phase1',
      },
      {
        need: 'Accessible agendas, minutes and reports',
        ref: 'RFP §2 ADA Accessibility',
        today: 'Agendas and minutes are scanned images with no text or tags. Bond overview is untagged',
        fix: 'An HTML version of every agenda and minutes, plus tagged PDFs, for current and new documents',
        status: 'phase1',
      },
      {
        need: 'A way to report a barrier',
        ref: 'Title II good practice',
        today: 'No accessibility statement or contact in the footer',
        fix: 'Accessibility statement, plus email and phone reporting on every page',
        status: 'done',
      },
    ],
  },
  {
    title: 'Meetings and recordings',
    rows: [
      {
        need: 'Accurate captions on meeting videos',
        ref: 'RFP §2 Meeting Videos · WCAG 1.2.2',
        today: 'Recordings on YouTube; captions not reviewed',
        fix: 'We edit each recording and publish it with reviewed captions, on a set turnaround',
        status: 'phase1',
      },
      {
        need: 'Text alternative for audio-only recordings',
        ref: 'RFP §2 Meeting Videos · WCAG 1.2.1',
        today: 'Audio recordings section has no files posted',
        fix: 'Any audio-only recording is published with a transcript',
        status: 'phase1',
      },
      {
        need: 'Recordings linked to agendas and minutes',
        ref: 'RFP §2 Meeting Videos',
        today: 'Agendas, minutes and videos sit in three separate lists',
        fix: 'One row per meeting with agenda, minutes, video and any hearing notice together',
        status: 'done',
      },
      {
        need: 'Easy to attend and find the next meeting',
        ref: 'Public access',
        today: 'Next meeting shown only inside a calendar widget',
        fix: 'Next meeting on the homepage, refreshed daily; in-person, Webex and phone details on the meetings page',
        status: 'done',
      },
    ],
  },
  {
    title: 'Ownership, upkeep and support',
    rows: [
      {
        need: 'Port owns its site, content, domain and accounts',
        ref: 'RFP §2 Design and Development',
        today: 'Footer privacy link points to an agency domain that no longer resolves',
        fix: 'Code, hosting account, domain and images all held in the Port\'s name. No lock-in',
        status: 'phase1',
      },
      {
        need: 'Publishing handled for the Port',
        ref: 'RFP §2 Ongoing Management',
        today: 'Staff upload documents by hand in a page-builder editor',
        fix: 'We publish agendas, minutes, notices and recordings. Staff can also email a document to publish it, with an automatic accessibility check',
        status: 'phase1',
      },
      {
        need: 'Fast on phones',
        ref: 'RFP §2 Mobile-friendly',
        today: 'Main content takes about 10 s to load on mobile (homepage); 1.4 MB page',
        fix: 'Static pages on Cloudflare: about 1.6 s and 250 KB',
        status: 'done',
      },
      {
        need: 'Security, backups and maintenance',
        ref: 'RFP §2 Ongoing Management',
        today: 'Plugins and server to keep patched',
        fix: 'No server or plugins to patch. Every change versioned and reversible. HTTPS everywhere',
        status: 'done',
      },
      {
        need: 'Staff training with written instructions',
        ref: 'RFP §2 Staff Training',
        today: '—',
        fix: 'Hands-on training plus a short written guide for routine updates',
        status: 'phase1',
      },
      {
        need: 'Accessible online forms',
        ref: 'RFP §2 ADA Accessibility',
        today: 'Contractor roster is a download-and-return PDF',
        fix: 'Accessible online roster application',
        status: 'phase2',
      },
    ],
  },
];

const counts = groups
  .flatMap((g) => g.rows)
  .reduce((acc, r) => ({ ...acc, [r.status]: (acc[r.status] ?? 0) + 1 }), {} as Record<Status, number>);
const total = groups.reduce((n, g) => n + g.rows.length, 0);
---

<Base
  title="Website readiness plan | Port of Centralia concept"
  description="What the Port of Centralia's website needs for ADA Title II and the RFP, what the current site does today, and how Stoke Leads will fix it."
>
  <div class="page-head on-dark">
    <div class="container">
      <p class="eyebrow">Stoke Leads · Response to the Port's Website RFP</p>
      <h1>Website readiness plan</h1>
      <p>What the Port's website must do, where it stands today, and how we close each gap well before the federal deadline.</p>
    </div>
  </div>

  <section class="section readiness" aria-labelledby="summary-heading">
    <div class="container">
      <h2 id="summary-heading" class="sr-only">At a glance</h2>
      <ul class="stat-cards">
        <li>
          <p class="stat-cards__value">Apr 26, 2028</p>
          <p class="stat-cards__label">ADA Title II compliance date for the Port, as set in the RFP and the DOJ rule (WCAG 2.1 AA)</p>
        </li>
        <li>
          <p class="stat-cards__value">89 <span>/</span> 78</p>
          <p class="stat-cards__label">Accessibility score today: homepage / agendas page (Lighthouse, out of 100)</p>
        </li>
        <li>
          <p class="stat-cards__value">100</p>
          <p class="stat-cards__label">Our working demo's score, with 0 automated accessibility errors</p>
        </li>
      </ul>

      <div class="readiness__head">
        <div>
          <p class="eyebrow">Checklist</p>
          <h2>What's needed and how we fix it</h2>
        </div>
        <ul class="legend" aria-label="Status key">
          <li><span class="status status--done"><Icon name="check" />{statusLabel.done}</span> {counts.done} of {total}</li>
          <li><span class="status status--phase1"><Icon name="clock" />{statusLabel.phase1}</span> {counts.phase1 ?? 0}</li>
          <li><span class="status status--phase2"><Icon name="arrow" />{statusLabel.phase2}</span> {counts.phase2 ?? 0}</li>
        </ul>
      </div>

      {
        groups.map((group) => (
          <table class="checklist">
            <caption>{group.title}</caption>
            <thead>
              <tr>
                <th scope="col">Requirement</th>
                <th scope="col">Today on portofcentralia.com</th>
                <th scope="col">How we fix it</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <tbody>
              {group.rows.map((row) => (
                <tr>
                  <th scope="row">
                    {row.need}
                    <span class="checklist__ref">{row.ref}</span>
                  </th>
                  <td data-label="Today">{row.today}</td>
                  <td data-label="How we fix it">{row.fix}</td>
                  <td data-label="Status">
                    <span class={`status status--${row.status}`}>
                      <Icon name={row.status === 'done' ? 'check' : row.status === 'phase1' ? 'clock' : 'arrow'} />
                      {statusLabel[row.status]}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        ))
      }
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="delivery-heading">
    <div class="container">
      <p class="eyebrow">Delivery</p>
      <h2 id="delivery-heading">Three steps, one accountable team</h2>
      <ol class="phases">
        <li>
          <p class="phases__step">1 · Launch</p>
          <h3>Accessible site, live</h3>
          <p>Full site on this foundation, owned by the Port. Current agendas, minutes and key documents rebuilt as HTML and tagged PDFs. Manual screen reader and keyboard audit. Staff training.</p>
        </li>
        <li>
          <p class="phases__step">2 · Simplify</p>
          <h3>We handle the publishing</h3>
          <p>Agendas, minutes, notices and captioned recordings published for the Port. Optional email-to-publish for staff. Online roster application.</p>
        </li>
        <li>
          <p class="phases__step">3 · Sustain</p>
          <h3>Stay compliant</h3>
          <p>Automated accessibility checks on every update, a quarterly manual review, and a public accessibility statement kept current.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="proof-heading">
    <div class="container proof">
      <div>
        <p class="eyebrow">Proof, not promises</p>
        <h2 id="proof-heading">See it working</h2>
        <p>
          This concept already runs on the Port's real meetings, documents and contact details. Every claim on this page
          can be checked in the demo.
        </p>
      </div>
      <div class="proof__actions">
        <a class="btn btn--primary" href="/">View the demo homepage <Icon name="arrow" /></a>
        <a class="btn btn--outline" href="/meetings">View the meetings page <Icon name="arrow" /></a>
      </div>
    </div>
    <div class="container">
      <p class="sources">
        Sources: the Port's <a href="https://portofcentralia.com/wp-content/uploads/2022/12/Port-of-Centralia-Website-RFP-2026.pdf">Website Redesign RFP</a>.
        Findings measured Oct 31, 2026 with Lighthouse 12 (mobile): full reports for the
        <a href="/audit/2026-10-31/portofcentralia-home.report.html">homepage</a> and
        <a href="/audit/2026-10-31/portofcentralia-agendas.report.html">agendas page</a>, and the
        <a href="/audit/2026-10-31/pdf-structure.txt">PDF structure check</a>. Compliance date from the U.S. Department of
        Justice <a href="https://www.federalregister.gov/documents/2026/04/20/2026-07663/extension-of-compliance-dates-for-nondiscrimination-on-the-basis-of-disability-accessibility-of-web">interim final rule of April 20, 2026</a>
        (28 CFR part 35), which keeps WCAG 2.1 AA as the standard. Load times vary from run to run.
      </p>
    </div>
  </section>
</Base>
