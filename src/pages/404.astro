---
import Base from '../layouts/Base.astro';
import { OFFICIAL_SITE } from '../data/site';
---

<Base title="Not part of this demo | Port of Centralia" description="This page is not included in the concept demo.">
  <div class="container notfound">
    <h1>This page isn't part of the demo</h1>
    <p>
      This concept demo covers the homepage and the meetings page only. The full site would include this page too.
    </p>
    <p>
      For current information, visit <a href={OFFICIAL_SITE}>portofcentralia.com</a>, or go back to the
      <a href="/">demo homepage</a>.
    </p>
  </div>
</Base>
