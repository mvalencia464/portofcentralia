---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { OFFICIAL_SITE, documents, contact, remoteAttendance } from '../data/site';
import { getMeetings, formatDate, meetingTitle, docOf } from '../lib/meetings';

const { upcoming, past } = await getMeetings();

// Group past meetings by month for scannable tables.
const byMonth = new Map<string, typeof past>();
for (const m of past) {
  const key = m.date.slice(0, 7);
  byMonth.set(key, [...(byMonth.get(key) ?? []), m]);
}
const monthName = (key: string) =>
  new Date(`${key}-15T12:00:00Z`).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', year: 'numeric' });
---

<Base
  title="Meetings, agendas & minutes | Port of Centralia"
  description="Port of Centralia Commission meetings: upcoming dates, agendas, minutes, and video recordings in one place."
>
  <div class="page-head on-dark">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><span aria-current="page">Meetings</span></li>
        </ol>
      </nav>
      <h1>Meetings, agendas &amp; minutes</h1>
      <p>Commission meetings are open to the public, in person or by Webex and phone. Each meeting's agenda, minutes, and video are listed together.</p>
    </div>
  </div>

  <section class="section" id="upcoming" aria-labelledby="upcoming-heading">
    <div class="container">
      <h2 id="upcoming-heading">Upcoming meetings</h2>
      {
        upcoming.length ? (
          <ul class="upcoming">
            {upcoming.map((m) => (
              <li>
                <time datetime={m.date}>{formatDate(m.date, 'weekday')}</time>
                <p>
                  {meetingTitle(m)}
                  {m.time && <>, {m.time}</>}
                </p>
                {m.hearing && <p class="upcoming__hearing">Public hearing: {m.hearing}</p>}
                {m.location && <p>{m.location} or remotely</p>}
                <p>{docOf(m, 'Agenda') ? 'Agenda posted' : 'Agenda not yet posted'}</p>
                {docOf(m, 'Notice') && (
                  <p>
                    <a href={docOf(m, 'Notice')!.href} aria-label={`Notice of public hearing (PDF), ${formatDate(m.date)}`}>
                      Notice of public hearing (PDF)
                    </a>
                  </p>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p>No upcoming meetings are scheduled yet.</p>
        )
      }

      <div class="attend" id="attend">
        <h2>Attend in person or remotely</h2>
        <div class="attend__grid">
          <div>
            <h3>In person</h3>
            <p>Port of Centralia office<br />{contact.street}, {contact.city}, {contact.region} {contact.postalCode}</p>
          </div>
          <div>
            <h3>By video (Webex)</h3>
            <p>
              <a href={remoteAttendance.webexLink}>Join the meeting on Webex</a><br />
              Meeting number: {remoteAttendance.meetingNumber}<br />
              Password: {remoteAttendance.password}
            </p>
          </div>
          <div>
            <h3>By phone</h3>
            <p>
              Call <a href={remoteAttendance.phoneHref}>{remoteAttendance.phone}</a><br />
              Access code: {remoteAttendance.meetingNumber}<br />
              Password: {remoteAttendance.password}
            </p>
          </div>
          <div>
            <h3>Public comment</h3>
            <p>
              Raise your hand in Webex, or press *3 on the phone. Written comments go to{' '}
              <a href={`mailto:${contact.email}`}>{contact.email}</a> by 2:00 pm on the meeting day.
            </p>
          </div>
        </div>
        <p class="attend__note">Call-in details can change. Each meeting's agenda has the current information.</p>
      </div>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="past-heading">
    <div class="container">
      <h2 id="past-heading">2026 meetings</h2>
      <p>
        Documents open as PDFs on portofcentralia.com. For 2021 to 2025, see the{' '}
        <a href={`${OFFICIAL_SITE}/documents-center/meeting-agendas-and-minutes/`}>current archive</a>.
      </p>
      {
        [...byMonth].map(([key, meetings]) => (
          <table class="meetings-table">
            <caption>{monthName(key)}</caption>
            <thead>
              <tr>
                <th scope="col">Date</th>
                <th scope="col">Meeting</th>
                <th scope="col">Agenda</th>
                <th scope="col">Minutes</th>
                <th scope="col">Video</th>
              </tr>
            </thead>
            <tbody>
              {meetings.map((m) => {
                const when = formatDate(m.date);
                const agendas = m.documents.filter((d) => d.kind === 'Agenda');
                const minutes = m.documents.filter((d) => d.kind === 'Minutes');
                return (
                  <tr>
                    <th scope="row">
                      <time datetime={m.date}>{formatDate(m.date, 'short')}</time>
                    </th>
                    <td data-label="Meeting">
                      {meetingTitle(m)}
                      {docOf(m, 'Notice') && (
                        <>
                          <br />
                          <a href={docOf(m, 'Notice')!.href} aria-label={`Hearing notice (PDF), ${when}`}>Hearing notice (PDF)</a>
                        </>
                      )}
                    </td>
                    <td data-label="Agenda">
                      {agendas.length ? (
                        <ul>
                          {agendas.map((d) => (
                            <li><a href={d.href} aria-label={`${d.label} (PDF), ${when}`}>{d.label} (PDF)</a></li>
                          ))}
                        </ul>
                      ) : (
                        <span class="pending">Not listed</span>
                      )}
                    </td>
                    <td data-label="Minutes">
                      {minutes.length ? (
                        <ul>
                          {minutes.map((d) => (
                            <li><a href={d.href} aria-label={`${d.label} (PDF), ${when}`}>{d.label} (PDF)</a></li>
                          ))}
                        </ul>
                      ) : (
                        <span class="pending">Pending approval</span>
                      )}
                    </td>
                    <td data-label="Video">
                      {m.video ? (
                        <a href={m.video} aria-label={`Watch on YouTube, ${when}`}>Watch on YouTube</a>
                      ) : (
                        <span class="pending">Not listed</span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        ))
      }
    </div>
  </section>

  <section class="section" id="videos" aria-labelledby="videos-heading">
    <div class="container">
      <h2 id="videos-heading">Meeting videos</h2>
      <p>Every recorded meeting is on the Port's YouTube channel. Turn on captions with the CC button in the player.</p>
      <a class="btn btn--outline" href={documents.meetingVideos}>All meeting videos on YouTube <Icon name="arrow" /></a>
    </div>
  </section>
</Base>
