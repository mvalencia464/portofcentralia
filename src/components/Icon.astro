  droplet: '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>',
  pipe: '<path d="M3 8h9a4 4 0 0 1 4 4v9M3 13h9v8"/><path d="M3 6v9M14 21h4"/>',
  bolt: '<path d="M13 2.5L5 13.5h6l-1 8 8-11h-6z"/>',
