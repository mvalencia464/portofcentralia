  people: '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.4"/><path d="M3.5 19.5a5.5 5.5 0 0 1 11 0M14.5 14.6a4.5 4.5 0 0 1 6 4.9"/>',
  news: '<rect x="3" y="4.5" width="15" height="15" rx="1.5"/><path d="M18 8.5h2a1 1 0 0 1 1 1v8.5a1.5 1.5 0 0 1-3 0M6.5 8.5h8M6.5 12h3.5M6.5 15.5h3.5M12.5 12h2v3.5h-2z"/>',
